# app/controllers/issues_controller.rb
class IssuesController < ApplicationController
  before_action :set_issue, only: [:show, :edit, :update, :destroy, :return_book]

  def index
    @issues = Issue.all
  end

  def show
  end

  def new
    @issue = Issue.new
  end

  def create
    @issue = Issue.new(issue_params)

    if @issue.save
      @issue.book.update(available: false)
      redirect_to issues_path, notice: "Book issued successfully"
    else
      redirect_to new_issue_path, alert: @issue.errors.full_messages.to_sentence
    end
  end

  def edit
  end

  def update
    if @issue.update(issue_params)
      redirect_to @issue
    else
      render :edit
    end
  end

  def destroy
    @issue.destroy
    redirect_to issues_path
  end

  def return_book
    @issue.update(return_date: Date.today)
    @issue.book.update(available: true)
    redirect_to issues_path, notice: "Book returned successfully"
  end

  private

  def set_issue
    @issue = Issue.find(params[:id])
  end

  def issue_params
    params.require(:issue).permit(:student_id, :book_id, :issue_date)
  end
end


# =========================
# ROUTES
# =========================

# config/routes.rb
Rails.application.routes.draw do
  root "books#index"

  resources :students
  resources :books
  resources :issues do
    member do
      patch :return_book
    end
  end
end
