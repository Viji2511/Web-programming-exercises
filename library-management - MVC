app/controllers/issues_controller.rb
class IssuesController < ApplicationController
  def index
    @issues = Issue.all
  end

  def new
    @issue = Issue.new
    @students = Student.all
    @books = Book.all
  end

  def create
    @issue = Issue.new(issue_params)

    if @issue.save
      # mark book unavailable
      @issue.book.update(available: false)
      redirect_to issues_path
    else
      @students = Student.all
      @books = Book.all
      render :new
    end
  end

  def return_book
    @issue = Issue.find(params[:id])
    @issue.update(return_date: Date.today)

    # mark book available again
    @issue.book.update(available: true)

    redirect_to issues_path
  end

  private

  def issue_params
    params.require(:issue).permit(:student_id, :book_id, :issue_date)
  end
end

config/routes.rb
Rails.application.routes.draw do
  root "books#index"

  resources :students
  resources :books
  resources :issues do
    member do
      patch :return_book
    end
  end
end


